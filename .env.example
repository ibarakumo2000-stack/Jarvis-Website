# Public website origin used for payment callbacks.
NEXT_PUBLIC_SITE_URL=https://jarvis-ai-2-zeta.vercel.app

# Existing official release fallback.
NEXT_PUBLIC_DESKTOP_RELEASES_URL=https://github.com/ibarakumo2000-stack/Mark-56/releases

# Paystack: keep secret keys server-side only. Use test keys before live mode.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=whsec_replace_me
PAYSTACK_CURRENCY=NGN

# Supabase project URL and service-role key. Never expose the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# A long random secret used to sign short-lived download authorization cookies.
DOWNLOAD_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Lifetime licence price in kobo (NGN 1 = 100 kobo) and display label.
JARVIS_LIFETIME_PRICE_KOBO=0
JARVIS_LIFETIME_PRICE_LABEL=Set your one-time price

# Create these recurring plans in Paystack and copy their plan codes here.
PAYSTACK_MONTHLY_PLAN_CODE=
PAYSTACK_YEARLY_PLAN_CODE=
JARVIS_MONTHLY_PRICE_LABEL=Set monthly price
JARVIS_YEARLY_PRICE_LABEL=Set yearly price
