# Public website origin used for payment callbacks.
NEXT_PUBLIC_SITE_URL=https://jarvis-ai-2-zeta.vercel.app

# Existing official release fallback.
NEXT_PUBLIC_DESKTOP_RELEASES_URL=https://github.com/ibarakumo2000-stack/Mark-56/releases

# Paystack: keep secret keys server-side only. Use test keys before live mode.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=whsec_replace_me
PAYSTACK_CURRENCY=NGN

# Supabase project URL and service-role key. Never expose the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# A long random secret used to sign short-lived download authorization cookies.
DOWNLOAD_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Lifetime licence price in kobo (NGN 1 = 100 kobo) and display label.
JARVIS_LIFETIME_PRICE_KOBO=0
JARVIS_LIFETIME_PRICE_LABEL=Set your one-time price

# Create these recurring plans in Paystack and copy their plan codes here.
PAYSTACK_MONTHLY_PLAN_CODE=
PAYSTACK_YEARLY_PLAN_CODE=
JARVIS_MONTHLY_PRICE_LABEL=Set monthly price
JARVIS_YEARLY_PRICE_LABEL=Set yearly price

# Cloudflare R2 private bucket for paid desktop installers.
R2_ACCOUNT_ID=replace_me
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET_NAME=jarvis-private-releases

# Set the private object key for each product tier and platform.
# Use separate keys for classic (56.0.0) and premium (latest) binaries.
JARVIS_CLASSIC_WINDOWS_OBJECT_KEY=releases/56.0.0/windows/JARVIS-Setup.exe
JARVIS_CLASSIC_LINUX_OBJECT_KEY=releases/56.0.0/linux/JARVIS-Linux.tar.gz
JARVIS_CLASSIC_MACOS_ARM64_OBJECT_KEY=releases/56.0.0/macos/JARVIS-macos-arm64.dmg
JARVIS_CLASSIC_MACOS_X86_64_OBJECT_KEY=releases/56.0.0/macos/JARVIS-macos-x86_64.dmg
JARVIS_PREMIUM_WINDOWS_OBJECT_KEY=releases/latest/windows/JARVIS-Setup.exe
JARVIS_PREMIUM_LINUX_OBJECT_KEY=releases/latest/linux/JARVIS-Linux.tar.gz
JARVIS_PREMIUM_MACOS_ARM64_OBJECT_KEY=releases/latest/macos/JARVIS-macos-arm64.dmg
JARVIS_PREMIUM_MACOS_X86_64_OBJECT_KEY=releases/latest/macos/JARVIS-macos-x86_64.dmg
